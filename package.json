{
  "name": "misskey-spreadsheet-mode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Portable spreadsheet UI for Misskey-compatible frontends.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/sheet-mode.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "src",
    "dist",
    "adapters",
    "integration",
    "docs",
    "COPYING",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run && node --test test/installer.test.mjs",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build",
    "sync:host": "node scripts/sync-host.mjs",
    "pack:source": "node scripts/package.mjs"
  },
  "peerDependencies": {
    "vue": ">=3.5.0",
    "misskey-js": "*"
  },
  "devDependencies": {
    "vue": "3.5.42",
    "@vitejs/plugin-vue": "6.0.8",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11",
    "typescript": "6.0.3",
    "happy-dom": "20.12.0",
    "sass-embedded": "1.103.1"
  }
}
